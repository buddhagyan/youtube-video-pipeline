# Normalize line endings: the repo stores LF, every checkout gets LF.
* text=auto eol=lf

# Media and binary assets must never be line-ending converted.
*.mp4  binary
*.mov  binary
*.webm binary
*.mkv  binary
*.mp3  binary
*.wav  binary
*.m4a  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.zip  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
